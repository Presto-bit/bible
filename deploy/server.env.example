# 生产环境固定参数（Presto Bible @ 阿里云 ECS）
# 可复制字段到 deploy/deploy.env、deploy/publish.env、.env.production

# ── Git ──
GIT_REPO=https://github.com/Presto-bit/bible.git
GIT_REPO_SSH=git@github.com:Presto-bit/bible.git
GIT_REMOTE=origin
GIT_BRANCH=main

# ── 服务器 ──
DEPLOY_HOST=8.152.6.105
# 阿里云 SSH 用户（当前：presto）
DEPLOY_SSH=presto@8.152.6.105
DEPLOY_ROOT=/opt/bible
DEPLOY_APP_DIR=/opt/bible
APP_USER=presto

# ── 公网域名 ──
PUBLIC_DOMAIN=2sc.prestoai.cn
PUBLIC_WEB_URL=https://2sc.prestoai.cn
NEXT_PUBLIC_API_BASE=https://2sc.prestoai.cn
API_BASE_URL=https://2sc.prestoai.cn

# H5 独立子域，Next.js basePath 留空（勿设 /2sc）
NEXT_PUBLIC_BASE_PATH=

# ── DNS（在域名控制台添加）──
# 类型 A  主机记录 2sc  记录值 8.152.6.105  TTL 600

# ── 安全组（阿里云 ECS）──
# 入方向：TCP 22（SSH）、TCP 80、TCP 443
# 勿对公网开放 5433 / 8011 / WEB_HOST_PORT（生产默认 3002）

# ── 朗读音频（方案 1：服务器不出网，本地镜像）──
# 1) 有网机器：python scripts/mirror_bible_audio.py --all --workers 4
#    升级音质（新约 springunv）：python scripts/mirror_bible_audio.py --all --force --workers 4
# 2) 同步：DEPLOY_SSH=presto@8.152.6.105 bash deploy/sync_bible_audio.sh
# 3) 生产 .env.production：
# BIBLE_AUDIO_OFFLINE=1
# BIBLE_AUDIO_STORAGE_DIR=/app/data/bible_audio
# BIBLE_AUDIO_HOST_DIR=/opt/bible/data/bible_audio
# BIBLE_AUDIO_FHL_CDN_NT=springunv
# BIBLE_AUDIO_FHL_CDN_OT=unv1
