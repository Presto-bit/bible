# 彼爱生产 cron — 请用脚本安装，不要手抄本文件到 crontab：
#   cd /opt/bible && bash deploy/cron/install_cron.sh
#
# 说明：系统 crontab 不会展开 ${PUSH_CRON_SECRET}；install_cron.sh 会把真实密钥写入行内。
# 若服务器 crontab 为 UTC、业务按北京时间，请在 crontab 顶部加：TZ=Asia/Shanghai

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin

# 以下时间表达式仅作参考（实际以 install_cron.sh 写入为准）：
# 20 4 * * *     POST /social/retention/run
# */30 6-22 * * *  与 0 23 * * *   POST /content/cron/daily-verse-warm
# 日志：/var/log/bible-retention.log  /var/log/bible-daily-verse-warm.log
